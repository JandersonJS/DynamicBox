<?xml version="1.0" encoding="UTF-8"?>
<theme defaultView="Tiles">
  <formatVersion>7</formatVersion>
    
  <feature supported="manufacturer">
  <view name="system">  

        <image name="iconBar" extra="static">
            <tile>false</tile>
            <size>0.3 0.065</size>
            <pos>0.35 0.008</pos>
            <origin>0 0</origin>
            <path>./main/media/band.svg</path>
            <roundCorners>0.02</roundCorners>
            <color>${baseColor}</color>
            <zIndex>80</zIndex>
        </image>

        <helpsystem name="help">
            <textColor>ffffff</textColor>
            <iconColor>ffffff</iconColor>
        </helpsystem>

        <text name="logoText">
          <fontPath>./main/fonts/Cabin-Bold.ttf</fontPath>
          <color>${baseColor}</color>
          <forceUppercase>true</forceUppercase>
        </text>
        
        <image name="logo">

        <storyboard event="scroll" repeatAt="1" ifSubset="staticTiles:yes">
          <animation property="opacity" from="1" to="1" duration="1" mode="Linear"/>
        </storyboard>

        <!-- try png -->
        <path>./main/squaredLogos/${system.theme}.png</path>
        <!-- try jpg -->
        <path>./main/squaredLogos/${system.theme}.jpg</path>
        <!-- check if lang resources exist -->
        <path>./main/squaredLogos/${system.theme}-${lang}.png</path>
        <path>./main/squaredLogos/${system.theme}-${lang}.jpg</path>
      </image>

        <image name="bottom" extra="static">
            <pos>0 1</pos>
            <origin>0 1</origin>
            <size>1 0.065</size>
            <path>./main/media/band.svg</path>
            <color>00000080</color>
            <zIndex>50</zIndex>
        </image>

        <image name="bottomLine" extra="true">
            <pos>0 0.935</pos>
            <origin>0 0</origin>
            <size>1 0.005</size>
            <path>./main/media/band.svg</path>
            <color>${baseColor}</color>
            <zIndex>50</zIndex>
        </image>

    <text name="systemInfoEx" extra="true" if="{system.name} == 'collections'">
      <text>Collections : {binding:subSystems}</text>
      <text lang="fr">Nombre de collections : {binding:subSystems}</text>
      <text lang="pt">Coleções : {binding:subSystems}</text>
    </text>
    <text name="systemInfoEx" extra="true" if="{system.name} == 'library' || {system.name} == 'screenshots'">
      <text>Items : {binding:total}</text>
      <text lang="fr">Nombre d'élements : {binding:total}</text>
      <text lang="es">Número de elementos: {binding:total}</text>
      <text lang="pt">Número de Imagens: {binding:total}</text>
    </text>

      <image name="avatar" extra="static" ifSubset="roundAvatar:off">
         <path>./main/avatars/${image.avatar}</path>
         <path ifSubset="system-avatar:custom">./custom-avatar.png</path>
         <pos>0.02 0.035</pos>
         <maxSize>0.063 0.063</maxSize>
         <roundCorners>0</roundCorners>
         <zIndex>99</zIndex>
         <linearSmooth>true</linearSmooth>
      </image>

      <image name="avatar" extra="static" ifSubset="roundAvatar:on">
         <path>./main/avatars/${image.avatar}</path>
         <path ifSubset="system-avatar:custom">./custom-avatar.png</path>
         <pos>0.02 0.035</pos>
         <maxSize>0.063 0.063</maxSize>
         <roundCorners>0.5</roundCorners>
         <zIndex>99</zIndex>
         <linearSmooth>true</linearSmooth>
      </image>

      <webimage name="avatar"  extra="static" if="{global.cheevos} == true" ifSubset="system-avatar:cheevos" ifSubset="roundAvatar:off">
         <path>https://media.retroachievements.org/UserPic/${global.cheevos.username}.png</path>
         <pos>0.02 0.035</pos>
         <maxSize>0.063 0.063</maxSize>
         <roundCorners>0</roundCorners>
         <zIndex>99</zIndex>
         <linearSmooth>true</linearSmooth>
       </webimage>

      <webimage name="avatar"  extra="static" if="{global.cheevos} == true" ifSubset="system-avatar:cheevos" ifSubset="roundAvatar:on">
         <path>https://media.retroachievements.org/UserPic/${global.cheevos.username}.png</path>
         <pos>0.02 0.035</pos>
         <maxSize>0.063 0.063</maxSize>
         <roundCorners>0.5</roundCorners>
         <zIndex>99</zIndex>
         <linearSmooth>true</linearSmooth>
       </webimage>
    </view>
  </feature> 
  
</theme>
